<view class="page us-page" style="padding-top: {{safeTop}}px">
  <demo-panel/>
  <inbox-banner/>
  <view class="eyebrow">TWO PEOPLE, ONE LITTLE WORLD</view><view class="page-title">我们的秘密小店</view>
  <view class="couple-card">
    <text class="couple-pattern">♡</text><view class="couple-avatars"><view class="avatar owner-avatar">{{meInitial}}</view><view class="join-heart">♡</view><view class="avatar baby-avatar">{{partnerInitial}}</view></view>
    <view class="couple-names">{{partner ? meName + ' 和 ' + partnerName : '等另一半来敲门'}}</view>
    <view class="couple-caption">{{partner ? '两个人，一只小狗，很多个小幸福。' : '交换一个暗号，住进同一间小店。'}}</view>
    <view wx:if="{{partner}}" class="connected-label">{{demoMode ? '单账号演示中的双人空间' : '♡ 两个人的小店已连线'}}</view>
    <block wx:else><button class="invite-button" bindtap="copyCode" disabled="{{busy}}"><text>{{inviteCode ? '专属暗号 · ' + inviteCode : '生成我们的小店暗号'}}</text><text>{{inviteCode ? '复制' : '生成 →'}}</text></button><view wx:if="{{inviteCode}}" class="invite-meta"><text>{{inviteExpiryText}}</text><text bindtap="regenerateInvite">换个暗号</text></view></block>
  </view>
  <view class="stats-grid"><view class="stat"><view class="stat-value">{{total}}</view><view class="stat-label">个亲密小动作</view></view><view class="stat featured"><view class="stat-value">{{daysText}}<text wx:if="{{partner && !demoMode}}">天</text></view><view class="stat-label">{{demoMode ? '切换身份体验双方' : '从小店连线开始'}}</view></view><view class="stat"><view class="status-dot {{cloudReady || demoMode ? 'online' : ''}}"></view><view class="stat-label">{{demoMode ? '本机演示空间' : (cloudReady ? '小狗信道已连接' : '小店暂时没连上')}}</view><text wx:if="{{!cloudReady && !demoMode}}" class="retry-link" bindtap="loadAccount">重试</text></view></view>
  <view class="account-card paper-card"><view class="section-title">想被怎么叫</view><view class="page-sub">只用你亲手写下的称呼。</view><view class="account-row"><input class="name-input" value="{{nicknameInput}}" bindinput="onNicknameInput" maxlength="20" placeholder="{{myRole === 'chef' ? '比如：宝宝的专属店长' : '比如：宝宝'}}"/><button class="save-button" bindtap="saveNickname" disabled="{{saving}}">收好</button></view>
    <view class="divider"></view><view class="section-title">我在小店里的身份</view>
    <view class="role-grid"><button class="role-card {{myRole === 'chef' ? 'chosen' : ''}}" data-role="chef" bindtap="selectRole" disabled="{{roleSaving || partner}}"><text class="role-icon">🗝️</text><view><view class="role-title">店长</view><view class="role-caption">认真接住每个小心愿</view></view><text wx:if="{{myRole === 'chef'}}" class="role-check">✓</text></button><button class="role-card {{myRole === 'diner' ? 'chosen baby' : ''}}" data-role="diner" bindtap="selectRole" disabled="{{roleSaving || partner}}"><text class="role-icon">🎀</text><view><view class="role-title">宝宝</view><view class="role-caption">小店里独一份的偏爱</view></view><text wx:if="{{myRole === 'diner'}}" class="role-check">✓</text></button></view>
    <view class="role-note">{{demoMode ? '点击页面顶部“切换身份”，轮流扮演店长和宝宝。' : (partner ? '你们的身份已经配好，两个人都可以送出和回应心愿。' : '你们分别选择店长和宝宝，再交换暗号。')}}</view>
    <block wx:if="{{!partner}}"><view class="divider"></view><view class="section-title">把另一半请进来</view><view class="page-sub">填入对方生成的 8 位暗号。</view><view class="account-row"><input class="name-input code-input" value="{{bindCode}}" bindinput="onBindInput" maxlength="8" placeholder="输入对方的暗号"/><button class="save-button sage-button" bindtap="bindPartner" disabled="{{busy}}">牵手</button></view></block>
  </view>
  <view class="couple-photo-card paper-card"><view class="photo-card-mark">♡</view><view class="section-title">小狗珍藏的相册</view><view class="page-sub">{{photoCount}} / {{albumLimit}} 张 · 首页点小狗，循环播放我们的合照。</view>
    <view class="album-limit-row"><text>相册上限</text><button wx:for="{{albumLimits}}" wx:key="*this" class="album-limit {{albumLimit === item ? 'chosen' : ''}}" data-limit="{{item}}" bindtap="setAlbumLimit" disabled="{{photoBusy || photoStateLoading || !partner}}">{{item}} 张</button><button class="album-refresh" bindtap="loadPhotoState" disabled="{{photoBusy || photoStateLoading}}">刷新 ↻</button></view>
    <view wx:if="{{photoError}}" class="album-error" bindtap="loadPhotoState">{{photoError}} · 点击刷新</view><view wx:if="{{photoStateLoading}}" class="photo-card-note">小狗正在整理相册…</view>
    <view wx:if="{{photoItems.length}}" class="album-grid"><view wx:for="{{photoItems}}" wx:key="id" class="album-tile"><view class="album-image-wrap" data-id="{{item.id}}" bindtap="previewCouplePhoto"><image wx:if="{{item.filePath}}" class="album-image" src="{{item.filePath}}" mode="aspectFill"/><view wx:else class="album-image-missing">轻点重新打开</view><text class="album-number">{{index === 0 ? '♡ 封面' : (index < 9 ? '0' + (index + 1) : index + 1)}}</text></view><button class="album-caption" data-id="{{item.id}}" bindtap="captionAlbumPhoto" disabled="{{photoBusy || photoStateLoading}}">{{item.caption || '给这一刻留句话 ✎'}}</button><view class="album-tools"><button wx:if="{{index > 0}}" data-id="{{item.id}}" bindtap="setAlbumCover" disabled="{{photoBusy || photoStateLoading}}">设封面</button><button wx:if="{{index > 0}}" data-id="{{item.id}}" bindtap="moveAlbumPhoto" disabled="{{photoBusy || photoStateLoading}}">前移</button><button class="album-delete" data-id="{{item.id}}" bindtap="removeCouplePhoto" disabled="{{photoBusy || photoStateLoading}}">移除</button></view></view></view>
    <view class="photo-card-actions"><button class="primary-button" bindtap="chooseCouplePhoto" loading="{{photoBusy}}" disabled="{{photoBusy || photoStateLoading || photoCount >= albumLimit}}">{{photoCount >= albumLimit ? '相册装满啦' : (hasPhoto ? '再放几张合照' : '选我们的合照')}}</button><button wx:if="{{hasPhoto}}" class="secondary-button" bindtap="previewCouplePhoto" disabled="{{photoBusy || photoStateLoading}}">放大看看</button></view><button wx:if="{{hasPhoto}}" class="album-play-link" bindtap="goPhotoShow">去首页点小狗播放 →</button><view class="photo-card-note">可以分次添加，最多 10 张。两个人都能整理；上传重试时会自动去重。播放时也会显示你写下的那句话。</view></view>
  <view class="section-head"><text class="section-title">把我们慢慢收好</text><text class="section-link">♡</text></view>
  <view class="our-grid"><button class="our-card butter" bindtap="goMemories"><text class="our-icon">🎞️</text><view class="our-title">回忆小票</view><view class="our-caption">认真兑现的小幸福</view></button><button class="our-card peach" bindtap="openLetter"><text class="our-icon">💌</text><view class="our-title">开店来信</view><view class="our-caption">想读的时候，随时打开</view></button></view>
  <button class="our-mail paper-card" bindtap="goNotes"><text>✉ 去看看我们的小纸条</text><text>→</text></button>
  <button class="our-mail paper-card" bindtap="goDaily"><text>🎁 今日心动与双向小秘密</text><text>→</text></button>
  <notification-settings/>
  <view class="privacy-links"><button bindtap="goPrivacy">隐私与数据说明 →</button><button wx:if="{{!demoMode}}" bindtap="toggleDemoEntry">{{showDemoEntry ? '收起单人体验 ↑' : '单人体验 ↓'}}</button><button wx:if="{{partner && !demoMode}}" bindtap="unbind">管理绑定关系</button><button bindtap="deletePersonalData">{{demoMode ? '清空演示数据' : '删除我的数据'}}</button></view>
  <view wx:if="{{!demoMode && showDemoEntry}}" class="demo-entry paper-card"><view class="section-title">一个人也可以先体验</view><view class="page-sub">轮流扮演店长和宝宝，试试发心愿、回信、心情天气和合照。</view><button class="secondary-button" bindtap="enterDemo" disabled="{{busy || photoBusy || saving || roleSaving}}">进入单账号演示</button><view class="photo-card-note">演示数据只保存在这台设备，退出后回到真实账号。</view></view>
  <view class="us-footnote">{{shop.name}} · v{{version}}<view>小狗负责送信，我负责爱你。</view><view wx:if="{{filingNumber}}" bindtap="goPrivacy">{{filingNumber}}</view></view>
</view>
<view wx:if="{{showLetter}}" class="overlay" bindtap="closeLetter"><view class="sheet" catchtap="noop"><view class="sheet-grip"></view><view class="sheet-head"><view class="sheet-title">给宝宝的一封开店信</view><button class="close-button" bindtap="closeLetter">×</button></view><scroll-view scroll-y class="letter-scroll"><view class="letter-stamp">FOR 宝宝 · WITH LOVE</view><view wx:for="{{shop.letter}}" wx:key="*this" class="letter-paragraph">{{item}}</view><view class="letter-signature">永远向你营业的店长和小狗 {{shop.puppy}} 🐾</view></scroll-view><button class="primary-button" bindtap="closeLetter">把这份心意收好</button></view></view>
