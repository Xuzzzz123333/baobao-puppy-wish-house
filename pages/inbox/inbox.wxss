.inbox-page{padding-bottom:80rpx}.back-link{margin:0 0 28rpx!important;padding:0!important;text-align:left;background:transparent;color:#b96542;font-size:25rpx}.inbox-tools{display:flex;justify-content:space-between;margin:28rpx 0}.inbox-tools button{margin:0;padding:10rpx 24rpx;border-radius:25rpx;background:#f3e5d6;font-size:23rpx;color:#825a43}.notice{padding:28rpx;margin-bottom:18rpx}.notice.unread{border-color:#d5a17a;background:#fff9ed}.notice-title{font-size:28rpx;font-weight:700;line-height:1.6}.unread-dot{display:inline-block;width:12rpx;height:12rpx;background:#c26f45;border-radius:50%;margin-right:12rpx}.notice-summary{font-size:25rpx;line-height:1.6;margin-top:12rpx;white-space:pre-wrap;word-break:break-all}.notice-meta{display:flex;justify-content:space-between;color:#a28b76;font-size:21rpx;margin-top:22rpx}.inbox-note,.error-text{font-size:23rpx;color:#9a816e;line-height:1.7;margin-top:24rpx}.error-text{color:#ae583d}
