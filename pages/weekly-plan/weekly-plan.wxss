.weekly-page {
  min-height: 100vh;
  padding-bottom: 70rpx;
}

.weekly-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back-button,
.header-space,
.week-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
}

.back-button,
.week-arrow {
  border: 1rpx solid rgba(32, 35, 31, 0.09);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.72);
  font-size: 30rpx;
}

.weekly-header .page-title,
.weekly-header .eyebrow {
  text-align: center;
}

.week-switcher {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 31rpx;
  padding: 23rpx;
  border-radius: 30rpx;
  background: #20231f;
  color: #fff;
  text-align: center;
}

.week-label {
  color: rgba(255, 255, 255, 0.54);
  font-size: 18rpx;
}

.week-title {
  margin-top: 5rpx;
  font-size: 24rpx;
  font-weight: 750;
}

.week-switcher .week-arrow {
  border-color: rgba(255, 255, 255, 0.1);
  background: rgba(255, 255, 255, 0.08);
}

.weekly-tip {
  margin: 17rpx 5rpx 24rpx;
  color: #908a81;
  font-size: 20rpx;
  line-height: 1.55;
}

.loading {
  padding: 80rpx 0;
  color: #969087;
  text-align: center;
}

.day-list {
  display: flex;
  flex-direction: column;
  gap: 13rpx;
}

.day-card {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(32, 35, 31, 0.07);
  border-radius: 27rpx;
  background: rgba(255, 255, 255, 0.68);
}

.day-card.today {
  border-color: #e75b43;
  background: #fae9e3;
}

.day-date {
  flex: 0 0 85rpx;
}

.day-name {
  font-size: 23rpx;
  font-weight: 800;
}

.day-short {
  margin-top: 5rpx;
  color: #9a948b;
  font-size: 17rpx;
}

.day-plan {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
}

.day-icons {
  font-size: 24rpx;
  letter-spacing: 3rpx;
}

.day-dishes {
  margin-top: 6rpx;
  overflow: hidden;
  color: #6e6962;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.day-empty {
  flex: 1;
  margin-left: 14rpx;
  color: #a39d94;
  font-size: 20rpx;
}

.day-count {
  flex: none;
  margin-left: 12rpx;
  padding: 7rpx 11rpx;
  border-radius: 999rpx;
  background: #e5ecdf;
  color: #617456;
  font-size: 17rpx;
  font-weight: 700;
}

.editor-mask {
  position: fixed;
  inset: 0;
  z-index: 1200;
  display: flex;
  align-items: flex-end;
  background: rgba(25, 25, 23, 0.42);
}

.editor-panel {
  width: 100%;
  padding: 28rpx 28rpx 0;
  border-radius: 38rpx 38rpx 0 0;
  background: #f8f4ed;
}

.editor-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.editor-eyebrow {
  color: #e75b43;
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.editor-title {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.close-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  background: #ebe6de;
  font-size: 32rpx;
}

.editor-note {
  margin-top: 14rpx;
  color: #918b82;
  font-size: 19rpx;
}

.dish-picker {
  height: 650rpx;
  margin-top: 16rpx;
}

.picker-dish {
  display: flex;
  align-items: center;
  margin-bottom: 11rpx;
  padding: 13rpx;
  border: 2rpx solid transparent;
  border-radius: 23rpx;
  background: #fff;
}

.picker-dish.selected {
  border-color: #6f8061;
  background: #edf2e9;
}

.picker-icon {
  display: flex;
  flex: 0 0 72rpx;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  overflow: hidden;
  border-radius: 18rpx;
  font-size: 34rpx;
}

.picker-icon image {
  width: 100%;
  height: 100%;
}

.picker-copy {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
}

.picker-name {
  font-size: 23rpx;
  font-weight: 750;
}

.picker-sub {
  margin-top: 4rpx;
  color: #99938a;
  font-size: 17rpx;
}

.picker-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: #ece8e1;
  color: #6d6861;
  font-size: 22rpx;
}

.picker-dish.selected .picker-check {
  background: #6f8061;
  color: #fff;
}

.save-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 86rpx;
  margin-top: 16rpx;
  border-radius: 25rpx;
  background: #20231f;
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
}
