.menu-page .page-title { font-size:43rpx; }
.search-box { display:flex; align-items:center; gap:15rpx; margin-top:25rpx; padding:20rpx 23rpx; border:1rpx solid #eaddcc; border-radius:23rpx; background:#fffdf8; color:#b29174; }
.search-box text { font-size:36rpx; line-height:1; }
.search-box input { flex:1; min-width:0; color:#71533f; font-size:25rpx; }
.category-scroll { width:calc(100% + 32rpx); margin-top:22rpx; white-space:nowrap; }
.category-row { display:flex; gap:13rpx; padding:2rpx 32rpx 16rpx 0; }
.category-tab { display:inline-flex; flex:none; align-items:center; gap:9rpx; padding:16rpx 22rpx; border:1rpx solid #e8dbca; border-radius:999rpx; background:#fffdf8; color:#9b8572; font-size:23rpx; }
.category-tab.selected { border-color:#b96542; background:#b96542; color:#fffaf0; }
.category-icon { font-size:26rpx; }
.draft-banner { display:flex; justify-content:space-between; gap:20rpx; margin:5rpx 0 20rpx; padding:19rpx; border-radius:17rpx; background:#eee9d6; color:#8a7d53; font-size:21rpx; }
.wish-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:20rpx; margin-top:9rpx; }
.wish-card { overflow:hidden; text-align:left; }
.wish-art { position:relative; display:flex; justify-content:center; align-items:center; height:160rpx; }
.wish-art > text:first-child { font-size:76rpx; }
.art-spark { position:absolute; top:24rpx; right:29rpx; color:rgba(129,96,61,.3); font-size:23rpx; }
.wish-card-copy { padding:22rpx 20rpx 18rpx; }
.wish-category { color:#b49b81; font-size:17rpx; letter-spacing:2rpx; }
.wish-title { margin-top:8rpx; font-size:28rpx; font-weight:700; line-height:1.5; }
.wish-description { min-height:65rpx; margin-top:8rpx; color:#a18a75; font-size:21rpx; line-height:1.6; }
.wish-card-bottom { display:flex; align-items:center; justify-content:space-between; margin-top:16rpx; color:#ad704c; font-size:21rpx; }
.wish-plus { display:flex; align-items:center; justify-content:center; width:40rpx; height:40rpx; border-radius:50%; background:#f6e8d6; font-size:29rpx; }
.custom-link { display:block; margin-top:16rpx; color:#b96542; }
.menu-footnote { margin-top:35rpx; color:#b49f89; font-size:20rpx; text-align:center; }
.composer-sheet { height:86vh; max-height:calc(100vh - 72px); padding-bottom:0; }
.composer-scroll { flex:1; min-height:0; height:0; padding:0 4rpx 12rpx; }
.composer-description { color:#a18a75; font-size:24rpx; line-height:1.7; }
.optional { color:#b09b87; font-size:20rpx; font-weight:400; }
.send-hint { margin:16rpx 0 20rpx; color:#aa947f; font-size:21rpx; }
.composer-footer { flex:none; padding:18rpx 0 calc(30rpx + env(safe-area-inset-bottom)); background:#fffaf2; }
.composer-footer .send-button { width:100%; min-height:96rpx; max-width:none; margin:0; }
