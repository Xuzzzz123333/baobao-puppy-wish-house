.ratings-page {
  min-height: 100vh;
  padding-bottom: 70rpx;
}

.ratings-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back-button,
.header-space {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
}

.back-button {
  border: 1rpx solid rgba(32, 35, 31, 0.09);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.72);
  font-size: 32rpx;
}

.ratings-header .page-title,
.ratings-header .eyebrow {
  text-align: center;
}

.rating-hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 32rpx;
  padding: 29rpx;
  border-radius: 33rpx;
  background: #e75b43;
  color: #fff;
}

.hero-label {
  color: rgba(255, 255, 255, 0.65);
  font-size: 19rpx;
}

.hero-count {
  margin-top: 4rpx;
  font-size: 44rpx;
  font-weight: 800;
}

.hero-count text {
  font-size: 19rpx;
}

.hero-copy {
  color: rgba(255, 255, 255, 0.75);
  font-size: 19rpx;
  line-height: 1.6;
  text-align: right;
}

.loading {
  padding: 80rpx 0;
  color: #969087;
  text-align: center;
}

.section-note {
  margin-top: 6rpx;
  color: #99938a;
  font-size: 19rpx;
}

.pending-count {
  color: #938d84;
  font-size: 20rpx;
}

.pending-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.pending-card {
  display: flex;
  align-items: center;
  padding: 18rpx;
  border: 1rpx solid rgba(32, 35, 31, 0.07);
  border-radius: 27rpx;
  background: rgba(255, 255, 255, 0.7);
}

.pending-icon {
  display: flex;
  flex: 0 0 70rpx;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  border-radius: 19rpx;
  background: #f0ebe4;
  font-size: 34rpx;
}

.pending-copy {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
}

.pending-title {
  font-size: 23rpx;
  font-weight: 750;
}

.pending-detail {
  margin-top: 5rpx;
  overflow: hidden;
  color: #969087;
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rate-button {
  margin-left: 13rpx;
  padding: 11rpx 15rpx;
  border-radius: 999rpx;
  background: #20231f;
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
}

.empty-pending,
.empty-board {
  padding: 35rpx 25rpx;
  border: 1rpx dashed rgba(32, 35, 31, 0.12);
  border-radius: 26rpx;
  color: #969087;
  font-size: 20rpx;
  line-height: 1.6;
  text-align: center;
}

.board-head {
  margin-top: 50rpx;
}

.leaderboard {
  overflow: hidden;
  border: 1rpx solid rgba(32, 35, 31, 0.07);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.66);
}

.board-item {
  display: flex;
  align-items: center;
  padding: 17rpx 19rpx;
}

.board-item + .board-item {
  border-top: 1rpx solid rgba(32, 35, 31, 0.06);
}

.rank {
  display: flex;
  flex: 0 0 42rpx;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #ece8e1;
  color: #777169;
  font-size: 18rpx;
  font-weight: 800;
}

.rank-1 {
  background: #f2d17d;
  color: #6f5317;
}

.rank-2 {
  background: #d9dfe1;
  color: #596267;
}

.rank-3 {
  background: #e6c4a2;
  color: #76502e;
}

.board-icon {
  display: flex;
  flex: 0 0 70rpx;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  margin-left: 13rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: #f2ede6;
  font-size: 34rpx;
}

.board-icon image {
  width: 100%;
  height: 100%;
}

.board-copy {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
}

.board-name {
  font-size: 23rpx;
  font-weight: 750;
}

.board-meta {
  margin-top: 4rpx;
  color: #9a948b;
  font-size: 17rpx;
}

.board-score {
  color: #e75b43;
  font-size: 22rpx;
  font-weight: 800;
}

.rating-mask {
  position: fixed;
  inset: 0;
  z-index: 1300;
  display: flex;
  align-items: flex-end;
  background: rgba(24, 24, 22, 0.46);
}

.rating-panel {
  width: 100%;
  padding: 32rpx 30rpx 0;
  border-radius: 40rpx 40rpx 0 0;
  background: #f8f4ed;
  text-align: center;
}

.rating-label {
  color: #e75b43;
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.rating-title {
  margin-top: 9rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.rating-dishes {
  margin-top: 9rpx;
  color: #8e887f;
  font-size: 20rpx;
}

.stars {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-top: 30rpx;
}

.star {
  color: #d9d4cd;
  font-size: 56rpx;
}

.star.active {
  color: #e75b43;
  transform: scale(1.08);
}

.score-copy {
  margin-top: 14rpx;
  color: #777169;
  font-size: 20rpx;
}

.comment-input {
  width: 100%;
  height: 130rpx;
  margin-top: 25rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(32, 35, 31, 0.09);
  border-radius: 22rpx;
  background: #fff;
  font-size: 21rpx;
  text-align: left;
}

.submit-rating {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  margin-top: 18rpx;
  border-radius: 24rpx;
  background: #20231f;
  color: #fff;
  font-size: 23rpx;
  font-weight: 800;
}

.cancel-rating {
  padding: 20rpx;
  color: #908a81;
  font-size: 20rpx;
}
