.roulette-page {
  min-height: 100vh;
  padding-bottom: 70rpx;
}

.roulette-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back-button,
.header-space {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
}

.back-button {
  border: 1rpx solid rgba(32, 35, 31, 0.09);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.72);
  font-size: 32rpx;
}

.roulette-header .page-title,
.roulette-header .eyebrow {
  text-align: center;
}

.mode-row {
  display: flex;
  gap: 12rpx;
  margin-top: 31rpx;
  padding: 7rpx;
  border-radius: 24rpx;
  background: #eee9e1;
}

.mode-pill {
  flex: 1;
  padding: 16rpx;
  border-radius: 18rpx;
  color: #827c73;
  font-size: 21rpx;
  font-weight: 700;
  text-align: center;
}

.mode-pill.active {
  background: #fff;
  box-shadow: 0 8rpx 20rpx rgba(55, 45, 36, 0.08);
  color: #20231f;
}

.source-note {
  margin-top: 13rpx;
  color: #989188;
  font-size: 19rpx;
  text-align: center;
}

.wheel-stage {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 590rpx;
}

.pointer {
  position: absolute;
  top: 39rpx;
  left: 50%;
  z-index: 4;
  color: #20231f;
  font-size: 45rpx;
  transform: translateX(-50%);
}

.wheel {
  position: relative;
  width: 500rpx;
  height: 500rpx;
  border: 12rpx solid #fff;
  border-radius: 50%;
  background: conic-gradient(
    #f3c9bc 0deg 60deg,
    #e7d893 60deg 120deg,
    #cddcbe 120deg 180deg,
    #c6dce5 180deg 240deg,
    #e2cee4 240deg 300deg,
    #f0d7ad 300deg 360deg
  );
  box-shadow: 0 28rpx 70rpx rgba(64, 49, 39, 0.17);
  transition: transform 3.6s cubic-bezier(0.12, 0.7, 0.12, 1);
}

.wheel::after {
  position: absolute;
  inset: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.48);
  border-radius: 50%;
  content: "";
}

.wheel-center {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border: 9rpx solid #fff;
  border-radius: 50%;
  background: #20231f;
  color: #e75b43;
  font-size: 36rpx;
  transform: translate(-50%, -50%);
}

.wheel-label {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 140rpx;
  margin-top: -38rpx;
  margin-left: -70rpx;
  text-align: center;
}

.wheel-icon {
  font-size: 37rpx;
}

.wheel-name {
  max-width: 130rpx;
  margin-top: 4rpx;
  overflow: hidden;
  color: #3c3935;
  font-size: 16rpx;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.spin-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 30rpx;
  background: #20231f;
  color: #fff;
  font-size: 27rpx;
  font-weight: 800;
}

.spin-button.disabled {
  opacity: 0.65;
}

.result-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(32, 35, 31, 0.07);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.74);
}

.result-label {
  color: #e75b43;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.result-main {
  display: flex;
  align-items: center;
  margin-top: 15rpx;
}

.result-icon {
  display: flex;
  flex: 0 0 88rpx;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  overflow: hidden;
  border-radius: 23rpx;
  font-size: 43rpx;
}

.result-icon image {
  width: 100%;
  height: 100%;
}

.result-copy {
  flex: 1;
  min-width: 0;
  margin-left: 17rpx;
}

.result-name {
  font-size: 27rpx;
  font-weight: 800;
}

.result-sub {
  margin-top: 6rpx;
  overflow: hidden;
  color: #928c83;
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-price {
  margin-left: 12rpx;
  font-size: 27rpx;
  font-weight: 800;
}

.result-actions {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 11rpx;
  margin-top: 20rpx;
}

.again-button,
.add-button {
  padding: 17rpx 12rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
}

.again-button {
  background: #eee9e2;
  color: #6f6961;
}

.add-button {
  background: #e75b43;
  color: #fff;
}
