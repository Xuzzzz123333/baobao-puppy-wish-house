.admin-page {
  padding-bottom: 70rpx;
}

.admin-header {
  display: grid;
  grid-template-columns: 72rpx 1fr 72rpx;
  align-items: center;
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border: 1rpx solid rgba(32, 35, 31, 0.1);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.72);
  font-size: 31rpx;
}

.admin-header .eyebrow,
.admin-header .page-title {
  text-align: center;
}

.admin-header .page-title {
  margin-top: 4rpx;
  font-size: 42rpx;
}

.header-space {
  width: 72rpx;
}

.admin-intro {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 38rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: #6f8061;
  color: #fff;
}

.intro-title {
  font-size: 27rpx;
  font-weight: 750;
}

.intro-sub {
  margin-top: 7rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 20rpx;
}

.dinner-time {
  flex: none;
  margin-left: 20rpx;
  padding: 12rpx 17rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.14);
  text-align: center;
}

.dinner-time-label {
  color: rgba(255, 255, 255, 0.62);
  font-size: 17rpx;
}

.dinner-time-value {
  margin-top: 4rpx;
  font-size: 23rpx;
  font-weight: 750;
}

.admin-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.sort-button {
  display: flex;
  flex: 0 0 174rpx;
  align-items: center;
  justify-content: center;
  height: 90rpx;
  border: 1rpx solid rgba(32, 35, 31, 0.1);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.76);
  color: #6f6a62;
  font-size: 20rpx;
  font-weight: 700;
}

.sort-button.active {
  border-color: #6f8061;
  background: #e5ecdf;
  color: #58694d;
}

.add-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 90rpx;
  flex: 1;
  margin-top: 0;
  border-radius: 28rpx;
  background: #20231f;
  color: #fff;
  font-size: 25rpx;
  font-weight: 700;
}

.sort-tip {
  margin-top: 13rpx;
  color: #7d776f;
  font-size: 19rpx;
  text-align: center;
}

.add-symbol {
  margin-right: 9rpx;
  color: #f08a77;
  font-size: 34rpx;
}

.loading {
  padding: 80rpx 0;
  color: #969087;
  font-size: 23rpx;
  text-align: center;
}

.admin-list {
  position: relative;
  width: 100%;
  margin-top: 20rpx;
}

.movable-dish {
  position: absolute;
  left: 0;
  width: 100%;
  height: 190rpx;
}

.movable-dish.dragging {
  z-index: 8;
}

.admin-dish {
  display: flex;
  align-items: center;
  width: 100%;
  height: 176rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(32, 35, 31, 0.07);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.72);
}

.movable-dish.dragging .admin-dish {
  border-color: rgba(111, 128, 97, 0.36);
  box-shadow: 0 18rpx 42rpx rgba(44, 50, 39, 0.18);
}

.admin-dish.unavailable {
  opacity: 0.62;
}

.dish-icon {
  display: flex;
  flex: 0 0 92rpx;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  font-size: 48rpx;
  overflow: hidden;
}

.dish-image {
  width: 100%;
  height: 100%;
}

.dish-main {
  flex: 1;
  min-width: 0;
  margin-left: 17rpx;
}

.dish-title-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.dish-name {
  overflow: hidden;
  font-size: 24rpx;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-price {
  flex: none;
  font-size: 24rpx;
  font-weight: 800;
}

.dish-meta {
  margin-top: 6rpx;
  color: #a09a91;
  font-size: 18rpx;
}

.dish-subtitle {
  margin-top: 5rpx;
  overflow: hidden;
  color: #827c74;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-actions {
  flex: none;
  margin-left: 16rpx;
}

.sold-text {
  color: #d1604f;
  font-weight: 700;
}

.drag-handle {
  display: flex;
  flex: 0 0 64rpx;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
  color: #73806a;
  font-size: 36rpx;
}

.mini-action {
  padding: 8rpx 11rpx;
  color: #65745b;
  font-size: 18rpx;
  font-weight: 650;
}

.mini-action.danger {
  color: #d3604e;
}

.empty-menu {
  padding: 90rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 68rpx;
}

.empty-title {
  margin-top: 15rpx;
  font-size: 27rpx;
  font-weight: 750;
}

.empty-sub {
  margin-top: 8rpx;
  color: #99938a;
  font-size: 21rpx;
}

.editor-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(21, 23, 20, 0.46);
}

.editor-panel {
  width: 100%;
  max-height: 90vh;
  padding: 30rpx 30rpx 0;
  border-radius: 42rpx 42rpx 0 0;
  background: #f9f5ee;
}

.editor-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.editor-eyebrow {
  color: #e75b43;
  font-size: 18rpx;
  font-weight: 750;
  letter-spacing: 3rpx;
}

.editor-title {
  margin-top: 5rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.close-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  background: #ebe6df;
  color: #625d56;
  font-size: 38rpx;
}

.editor-scroll {
  max-height: 58vh;
  margin-top: 22rpx;
}

.field-label {
  margin: 19rpx 2rpx 9rpx;
  color: #615c55;
  font-size: 20rpx;
  font-weight: 700;
}

.field-input {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 78rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(32, 35, 31, 0.09);
  border-radius: 22rpx;
  background: #fff;
  color: #20231f;
  font-size: 23rpx;
}

.field-row {
  display: flex;
  gap: 14rpx;
}

.field-half {
  flex: 1;
  min-width: 0;
}

.icon-input {
  text-align: center;
}

.picker-input {
  box-sizing: border-box;
}

.image-field {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.image-preview {
  display: flex;
  flex: 0 0 150rpx;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 150rpx;
  overflow: hidden;
  border: 1rpx dashed rgba(32, 35, 31, 0.18);
  border-radius: 28rpx;
  background: #fff;
}

.image-preview-file {
  width: 100%;
  height: 100%;
}

.image-placeholder {
  color: #99928a;
  font-size: 18rpx;
  text-align: center;
}

.image-placeholder-icon {
  margin-bottom: 6rpx;
  color: #e75b43;
  font-size: 38rpx;
}

.image-copy {
  flex: 1;
}

.image-copy-title {
  font-size: 22rpx;
  font-weight: 700;
}

.image-copy-sub {
  margin-top: 7rpx;
  color: #9a938a;
  font-size: 18rpx;
}

.remove-image {
  display: inline-flex;
  margin-top: 12rpx;
  padding: 8rpx 13rpx;
  border-radius: 999rpx;
  background: #f7e4de;
  color: #c25543;
  font-size: 18rpx;
}

.availability-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 19rpx;
  padding: 6rpx 3rpx;
}

.availability-label {
  margin-top: 0;
}

.availability-sub {
  margin-top: 5rpx;
  color: #9a938a;
  font-size: 18rpx;
}

.ingredient-section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 20rpx;
}

.ingredient-title {
  margin-top: 0;
}

.ingredient-help {
  color: #9a938a;
  font-size: 18rpx;
}

.ingredient-add {
  flex: none;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #e4ebde;
  color: #5d7053;
  font-size: 19rpx;
  font-weight: 700;
}

.ingredient-empty {
  margin-top: 13rpx;
  padding: 22rpx;
  border: 1rpx dashed rgba(32, 35, 31, 0.12);
  border-radius: 22rpx;
  color: #99938a;
  font-size: 19rpx;
  line-height: 1.55;
  text-align: center;
}

.ingredient-editor {
  margin-top: 14rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(32, 35, 31, 0.08);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.65);
}

.ingredient-editor-head,
.ingredient-optional {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ingredient-editor-head {
  margin-bottom: 12rpx;
  color: #5f5a53;
  font-size: 20rpx;
  font-weight: 750;
}

.ingredient-remove {
  color: #d3604e;
  font-size: 18rpx;
}

.ingredient-row {
  display: flex;
  gap: 9rpx;
  margin-top: 10rpx;
}

.ingredient-quantity {
  flex: 0 0 150rpx;
}

.ingredient-picker {
  flex: 0 0 120rpx;
}

.ingredient-picker.category-picker {
  flex: 1;
}

.ingredient-picker .field-input {
  justify-content: center;
  padding: 0 10rpx;
}

.disabled-input {
  background: #eeebe5;
  color: #aaa39a;
}

.ingredient-note {
  margin-top: 10rpx;
}

.ingredient-optional {
  margin-top: 12rpx;
}

.optional-title {
  color: #615c55;
  font-size: 19rpx;
  font-weight: 700;
}

.optional-sub {
  margin-top: 4rpx;
  color: #9a938a;
  font-size: 17rpx;
}

.save-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  margin-top: 25rpx;
  border-radius: 29rpx;
  background: #20231f;
  color: #fff;
  font-size: 25rpx;
  font-weight: 750;
}

.save-button.disabled {
  opacity: 0.55;
}
