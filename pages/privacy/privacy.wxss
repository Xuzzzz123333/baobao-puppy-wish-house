.privacy-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

.privacy-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back-button,
.header-space {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
}

.back-button {
  border: 1rpx solid rgba(32, 35, 31, 0.09);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.72);
  font-size: 32rpx;
}

.privacy-header .page-title,
.privacy-header .eyebrow {
  text-align: center;
}

.privacy-hero {
  position: relative;
  margin-top: 34rpx;
  padding: 34rpx;
  overflow: hidden;
  border-radius: 36rpx;
  background: #20231f;
  color: #fff;
}

.hero-mark {
  position: absolute;
  top: -70rpx;
  right: -10rpx;
  color: rgba(255, 255, 255, 0.05);
  font-size: 250rpx;
}

.hero-title {
  position: relative;
  font-size: 31rpx;
  font-weight: 800;
}

.hero-sub {
  position: relative;
  margin-top: 13rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 21rpx;
  line-height: 1.65;
}

.privacy-section {
  display: flex;
  gap: 19rpx;
  margin-top: 18rpx;
  padding: 25rpx;
  border: 1rpx solid rgba(32, 35, 31, 0.07);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.68);
}

.section-number {
  flex: 0 0 50rpx;
  color: #e75b43;
  font-size: 19rpx;
  font-weight: 800;
}

.section-copy {
  flex: 1;
}

.section-title {
  font-size: 25rpx;
  font-weight: 750;
}

.section-text {
  margin-top: 9rpx;
  color: #777169;
  font-size: 21rpx;
  line-height: 1.7;
}

.privacy-tip {
  margin-top: 22rpx;
  padding: 20rpx 23rpx;
  border-radius: 23rpx;
  background: #f6e4dd;
  color: #a74b3d;
  font-size: 20rpx;
  line-height: 1.55;
}
.privacy-action{margin:16rpx 0 0;padding:12rpx 0;background:transparent;font-size:22rpx;line-height:1.7;color:#a2714f;text-align:left;word-break:break-all}.privacy-meta{margin-top:25rpx;color:#a28f7d;font-size:20rpx;text-align:center}.privacy-filing{margin-top:16rpx;background:transparent;font-size:20rpx;color:#a28f7d}
