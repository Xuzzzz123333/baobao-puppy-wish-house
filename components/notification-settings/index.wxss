.notify-card{margin:24rpx 0;padding:28rpx;background:#fffdf8;border:1rpx solid #ead9c5;border-radius:28rpx;color:#574436}.notify-title{font-size:28rpx;font-weight:700}.notify-copy{font-size:23rpx;line-height:1.7;color:#9a816e;margin:12rpx 0}.notify-divider{height:1rpx;background:#ead9c5;margin:28rpx 0}.notify-button{margin:18rpx 0 0;padding:15rpx 20rpx;background:#f5e4d0;border-radius:20rpx;font-size:25rpx;color:#8b573a}.notify-stop{margin:14rpx 0 0;background:transparent;color:#9a816e;font-size:22rpx}
.notify-test{margin:14rpx 0 0;padding:15rpx 20rpx;background:#eaf0e2;border-radius:20rpx;font-size:25rpx;color:#637456}
