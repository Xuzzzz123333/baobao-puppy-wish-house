.demo-panel { box-sizing:border-box; margin:0 0 28rpx; padding:22rpx; border:1rpx dashed #b49b65; border-radius:22rpx; background:#f5ecd2; }
.demo-title { color:#806333; font-size:25rpx; font-weight:650; }
.demo-caption { margin-top:9rpx; color:#a18b60; font-size:20rpx; line-height:1.7; }
.demo-actions { display:flex; align-items:center; gap:13rpx; margin-top:17rpx; }
.demo-actions button { box-sizing:border-box; width:auto; min-width:0; margin:0; padding:14rpx 20rpx; border-radius:16rpx; background:#fffaf0; color:#947a49; font-size:22rpx; line-height:1.5; }
.demo-actions button::after { border:0; }
.demo-actions .demo-switch { background:#9c8150; color:#fffaf0; }
