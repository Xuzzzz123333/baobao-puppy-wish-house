.new-mail{display:flex;align-items:center;gap:18rpx;margin:0 0 24rpx;padding:24rpx;border:1rpx solid #e7c8ae;border-radius:24rpx;background:#f8e7d5;color:#754b35}.mail-icon{position:relative;font-size:40rpx}.mail-icon text{position:absolute;top:-12rpx;right:-14rpx;min-width:22rpx;padding:2rpx 5rpx;border-radius:20rpx;background:#b96542;color:#fff;font-size:17rpx;text-align:center}.mail-copy{flex:1;min-width:0}.mail-title{font-size:25rpx;font-weight:700}.mail-summary{font-size:22rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;margin-top:6rpx;opacity:.8}.mail-link{font-size:23rpx;flex-shrink:0}
