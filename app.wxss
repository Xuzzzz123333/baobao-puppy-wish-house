page { min-height:100%; background:#fff8ee; color:#49382f; font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif; }
view,text,button,input,textarea,scroll-view { box-sizing:border-box; }
button { margin:0; padding:0; min-width:0; font-size:inherit; line-height:inherit; background:transparent; color:inherit; }
button:not([size='mini']) { width:auto; margin-left:0; margin-right:0; }
button::after { border:0; }
button[disabled] { opacity:.55; color:inherit; }
.page { min-height:100vh; padding:66px 32rpx calc(190rpx + env(safe-area-inset-bottom)); }
.eyebrow { color:#b96542; font-size:20rpx; font-weight:700; letter-spacing:3rpx; }
.page-title { margin-top:12rpx; color:#49382f; font-size:48rpx; font-weight:750; line-height:1.3; letter-spacing:-1rpx; }
.page-sub { margin-top:12rpx; color:#998474; font-size:24rpx; line-height:1.7; }
.section-head { display:flex; align-items:center; justify-content:space-between; margin:38rpx 2rpx 20rpx; }
.section-title { font-size:30rpx; font-weight:700; }
.section-link { color:#b96542; font-size:23rpx; }
button.primary-button,button.secondary-button { display:flex; align-items:center; justify-content:center; width:100%; min-height:88rpx; padding:20rpx; border-radius:26rpx; font-size:27rpx; font-weight:650; text-align:center; }
.primary-button { background:#b96542; color:#fffdf8; }
.secondary-button { border:1rpx solid #e6d8c8; background:#fffdf8; color:#795f4d; }
.muted { color:#9c8878; }
.paper-card { border:1rpx solid #eee2d2; border-radius:30rpx; background:#fffdf8; }
.empty-state { padding:45rpx 28rpx; color:#9c8878; font-size:25rpx; line-height:1.8; text-align:center; }
.overlay { position:fixed; top:0; right:0; bottom:0; left:0; z-index:2000; display:flex; align-items:flex-end; background:rgba(62,43,31,.37); }
.sheet { display:flex; flex-direction:column; width:100%; max-height:90vh; overflow:hidden; padding:30rpx 32rpx calc(30rpx + env(safe-area-inset-bottom)); border-radius:44rpx 44rpx 0 0; background:#fffaf2; }
.sheet-grip { flex:none; width:64rpx; height:7rpx; margin:0 auto 28rpx; border-radius:9rpx; background:#ddcdbc; }
.sheet-head { display:flex; flex:none; align-items:center; justify-content:space-between; gap:20rpx; margin-bottom:20rpx; }
.sheet-title { flex:1; min-width:0; font-size:34rpx; font-weight:750; }
.sheet .close-button { display:flex; flex:0 0 72rpx; align-items:center; justify-content:center; width:72rpx; min-width:72rpx; max-width:72rpx; height:72rpx; margin:0; padding:0; border-radius:50%; background:#f2e8dc; color:#8e7763; font-size:35rpx; line-height:1; }
.sheet scroll-view { min-height:0; }
.chip-row { display:flex; flex-wrap:wrap; gap:12rpx; }
.chip-row .choice { display:inline-flex; flex:0 0 auto; align-items:center; width:auto; max-width:100%; margin:0; padding:16rpx 22rpx; border:1rpx solid #e9dccd; border-radius:20rpx; background:#fffdf8; color:#917965; font-size:24rpx; line-height:1.5; text-align:left; }
.choice.active { border-color:#ba7450; background:#f7e4d1; color:#9b5334; font-weight:650; }
.field-label { margin:26rpx 0 15rpx; color:#6e5140; font-size:25rpx; font-weight:650; }
.note-input { display:block; width:100%; min-height:150rpx; padding:22rpx; border:1rpx solid #e7d8c6; border-radius:23rpx; background:#fffdf8; font-size:26rpx; line-height:1.7; }
.input-counter { margin-top:8rpx; color:#ab9784; font-size:19rpx; text-align:right; }
.safe-bottom { height:env(safe-area-inset-bottom); }
.peach { background:#fae1d0; } .sage { background:#e6ecd9; } .blue { background:#e0eaf0; } .butter { background:#f5edcf; } .lilac { background:#ede3f0; }
